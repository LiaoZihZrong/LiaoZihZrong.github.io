{
  "translation": "Chinese_Union_Version_Traditional",
  "testament": "Old_Testament",
  "testament_zh": "舊約",
  "book": "Job",
  "book_zh": "約伯記",
  "chapter": 16,
  "verse_count": 22,
  "verses": [
    {
      "verse": 1,
      "text": "約伯回答說："
    },
    {
      "verse": 2,
      "text": "這樣的話我聽了許多；你們安慰人，反叫人愁煩。"
    },
    {
      "verse": 3,
      "text": "虛空的言語有窮盡嗎？有什麼話惹動你回答呢？"
    },
    {
      "verse": 4,
      "text": "我也能說你們那樣的話；你們若處在我的境遇，我也會聯絡言語攻擊你們，又能向你們搖頭。"
    },
    {
      "verse": 5,
      "text": "但我必用口堅固你們，用嘴消解你們的憂愁。"
    },
    {
      "verse": 6,
      "text": "我雖說話，憂愁仍不得消解；我雖停住不說，憂愁就離開我嗎？"
    },
    {
      "verse": 7,
      "text": "但現在神使我困倦，使親友遠離我，"
    },
    {
      "verse": 8,
      "text": "又抓住我，作見證攻擊我；我身體的枯瘦也當面見證我的不是。"
    },
    {
      "verse": 9,
      "text": "主發怒撕裂我，逼迫我，向我切齒；我的敵人怒目看我。"
    },
    {
      "verse": 10,
      "text": "他們向我開口，打我的臉羞辱我，聚會攻擊我。"
    },
    {
      "verse": 11,
      "text": "神把我交給不敬虔的人，把我扔到惡人的手中。"
    },
    {
      "verse": 12,
      "text": "我素來安逸，他折斷我，掐住我的頸項，把我摔碎，又立我為他的箭靶子。"
    },
    {
      "verse": 13,
      "text": "他的弓箭手四面圍繞我；他破裂我的肺腑，並不留情，把我的膽傾倒在地上，"
    },
    {
      "verse": 14,
      "text": "將我破裂又破裂，如同勇士向我直闖。"
    },
    {
      "verse": 15,
      "text": "我縫麻布在我皮膚上，把我的角放在塵土中。"
    },
    {
      "verse": 16,
      "text": "我的臉因哭泣發紫，在我的眼皮上有死蔭。"
    },
    {
      "verse": 17,
      "text": "我的手中卻無強暴；我的祈禱也是清潔。"
    },
    {
      "verse": 18,
      "text": "地啊，不要遮蓋我的血！不要阻擋我的哀求！"
    },
    {
      "verse": 19,
      "text": "現今，在天有我的見證，在上有我的中保。"
    },
    {
      "verse": 20,
      "text": "我的朋友譏誚我，我卻向神眼淚汪汪。"
    },
    {
      "verse": 21,
      "text": "願人得與神辯白，如同人與朋友辯白一樣；"
    },
    {
      "verse": 22,
      "text": "因為再過幾年，我必走那往而不返之路。"
    }
  ]
}
