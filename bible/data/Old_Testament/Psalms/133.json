{
  "translation": "Chinese_Union_Version_Traditional",
  "testament": "Old_Testament",
  "testament_zh": "舊約",
  "book": "Psalms",
  "book_zh": "詩篇",
  "chapter": 133,
  "verse_count": 3,
  "verses": [
    {
      "verse": 1,
      "text": "（大衛上行之詩。）看哪，弟兄和睦同居是何等地善，何等地美！"
    },
    {
      "verse": 2,
      "text": "這好比那貴重的油澆在亞倫的頭上，流到鬍鬚，又流到他的衣襟；"
    },
    {
      "verse": 3,
      "text": "又好比黑門的甘露降在錫安山；因為在那裡有耶和華所命定的福，就是永遠的生命。"
    }
  ]
}
