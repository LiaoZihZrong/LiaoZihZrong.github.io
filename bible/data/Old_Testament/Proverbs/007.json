{
  "translation": "Chinese_Union_Version_Traditional",
  "testament": "Old_Testament",
  "testament_zh": "舊約",
  "book": "Proverbs",
  "book_zh": "箴言",
  "chapter": 7,
  "verse_count": 27,
  "verses": [
    {
      "verse": 1,
      "text": "我兒，你要遵守我的言語，將我的命令存記在心。"
    },
    {
      "verse": 2,
      "text": "遵守我的命令就得存活；保守我的法則（或譯：指教），好像保守眼中的瞳人，"
    },
    {
      "verse": 3,
      "text": "繫在你指頭上，刻在你心版上。"
    },
    {
      "verse": 4,
      "text": "對智慧說：你是我的姊妹，稱呼聰明為你的親人，"
    },
    {
      "verse": 5,
      "text": "他就保你遠離淫婦，遠離說諂媚話的外女。"
    },
    {
      "verse": 6,
      "text": "我曾在我房屋的窗戶內，從我窗櫺之間往外觀看："
    },
    {
      "verse": 7,
      "text": "見愚蒙人內，少年人中，分明有一個無知的少年人，"
    },
    {
      "verse": 8,
      "text": "從街上經過，走近淫婦的巷口，直往通他家的路去，"
    },
    {
      "verse": 9,
      "text": "在黃昏，或晚上，或半夜，或黑暗之中。"
    },
    {
      "verse": 10,
      "text": "看哪，有一個婦人來迎接他，是妓女的打扮，有詭詐的心思。"
    },
    {
      "verse": 11,
      "text": "這婦人喧嚷，不守約束，在家裡停不住腳，"
    },
    {
      "verse": 12,
      "text": "有時在街市上，有時在寬闊處，或在各巷口蹲伏，"
    },
    {
      "verse": 13,
      "text": "拉住那少年人，與他親嘴，臉無羞恥對他說："
    },
    {
      "verse": 14,
      "text": "平安祭在我這裡，今日才還了我所許的願。"
    },
    {
      "verse": 15,
      "text": "因此，我出來迎接你，懇切求見你的面，恰巧遇見了你。"
    },
    {
      "verse": 16,
      "text": "我已經用繡花毯子和埃及線織的花紋布鋪了我的床。"
    },
    {
      "verse": 17,
      "text": "我又用沒藥、沉香、桂皮薰了我的榻。"
    },
    {
      "verse": 18,
      "text": "你來，我們可以飽享愛情，直到早晨；我們可以彼此親愛歡樂。"
    },
    {
      "verse": 19,
      "text": "因為我丈夫不在家，出門行遠路；"
    },
    {
      "verse": 20,
      "text": "他手拿銀囊，必到月望才回家。"
    },
    {
      "verse": 21,
      "text": "淫婦用許多巧言誘他隨從，用諂媚的嘴逼他同行。"
    },
    {
      "verse": 22,
      "text": "少年人立刻跟隨他，好像牛往宰殺之地，又像愚昧人帶鎖鍊去受刑罰，"
    },
    {
      "verse": 23,
      "text": "直等箭穿他的肝，如同雀鳥急入網羅，卻不知是自喪己命。"
    },
    {
      "verse": 24,
      "text": "眾子啊，現在要聽從我，留心聽我口中的話。"
    },
    {
      "verse": 25,
      "text": "你的心不可偏向淫婦的道，不要入他的迷途。"
    },
    {
      "verse": 26,
      "text": "因為，被他傷害仆倒的不少；被他殺戮的而且甚多。"
    },
    {
      "verse": 27,
      "text": "他的家是在陰間之路，下到死亡之宮。"
    }
  ]
}
