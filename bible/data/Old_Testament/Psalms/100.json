{
  "translation": "Chinese_Union_Version_Traditional",
  "testament": "Old_Testament",
  "testament_zh": "舊約",
  "book": "Psalms",
  "book_zh": "詩篇",
  "chapter": 100,
  "verse_count": 5,
  "verses": [
    {
      "verse": 1,
      "text": "（稱謝詩。）普天下當向耶和華歡呼！"
    },
    {
      "verse": 2,
      "text": "你們當樂意事奉耶和華，當來向他歌唱！"
    },
    {
      "verse": 3,
      "text": "你們當曉得耶和華是神！我們是他造的，也是屬他的；我們是他的民，也是他草場的羊。"
    },
    {
      "verse": 4,
      "text": "當稱謝進入他的門；當讚美進入他的院。當感謝他，稱頌他的名！"
    },
    {
      "verse": 5,
      "text": "因為耶和華本為善。他的慈愛存到永遠；他的信實直到萬代。"
    }
  ]
}
