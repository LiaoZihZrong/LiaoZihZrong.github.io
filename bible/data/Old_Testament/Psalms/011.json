{
  "translation": "Chinese_Union_Version_Traditional",
  "testament": "Old_Testament",
  "testament_zh": "舊約",
  "book": "Psalms",
  "book_zh": "詩篇",
  "chapter": 11,
  "verse_count": 7,
  "verses": [
    {
      "verse": 1,
      "text": "（大衛的詩，交與伶長。）我是投靠耶和華；你們怎麼對我說：你當像鳥飛往你的山去。"
    },
    {
      "verse": 2,
      "text": "看哪，惡人彎弓，把箭搭在弦上，要在暗中射那心裡正直的人。"
    },
    {
      "verse": 3,
      "text": "根基若毀壞，義人還能做什麼呢？"
    },
    {
      "verse": 4,
      "text": "耶和華在他的聖殿裡；耶和華的寶座在天上；他的慧眼察看世人。"
    },
    {
      "verse": 5,
      "text": "耶和華試驗義人；惟有惡人和喜愛強暴的人，他心裡恨惡。"
    },
    {
      "verse": 6,
      "text": "他要向惡人密布網羅；有烈火、硫磺、熱風，作他們杯中的分。"
    },
    {
      "verse": 7,
      "text": "因為耶和華是公義的，他喜愛公義；正直人必得見他的面。"
    }
  ]
}
