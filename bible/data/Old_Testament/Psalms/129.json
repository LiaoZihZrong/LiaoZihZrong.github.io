{
  "translation": "Chinese_Union_Version_Traditional",
  "testament": "Old_Testament",
  "testament_zh": "舊約",
  "book": "Psalms",
  "book_zh": "詩篇",
  "chapter": 129,
  "verse_count": 8,
  "verses": [
    {
      "verse": 1,
      "text": "（上行之詩。）以色列當說：從我幼年以來，敵人屢次苦害我，"
    },
    {
      "verse": 2,
      "text": "從我幼年以來，敵人屢次苦害我，卻沒有勝了我。"
    },
    {
      "verse": 3,
      "text": "如同扶犁的在我背上扶犁而耕，耕的犁溝甚長。"
    },
    {
      "verse": 4,
      "text": "耶和華是公義的；他砍斷了惡人的繩索。"
    },
    {
      "verse": 5,
      "text": "願恨惡錫安的都蒙羞退後！"
    },
    {
      "verse": 6,
      "text": "願他們像房頂上的草，未長成而枯乾，"
    },
    {
      "verse": 7,
      "text": "收割的不夠一把，捆禾的也不滿懷。"
    },
    {
      "verse": 8,
      "text": "過路的也不說：願耶和華所賜的福歸與你們！我們奉耶和華的名給你們祝福！"
    }
  ]
}
