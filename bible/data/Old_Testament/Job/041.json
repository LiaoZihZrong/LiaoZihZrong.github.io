{
  "translation": "Chinese_Union_Version_Traditional",
  "testament": "Old_Testament",
  "testament_zh": "舊約",
  "book": "Job",
  "book_zh": "約伯記",
  "chapter": 41,
  "verse_count": 34,
  "verses": [
    {
      "verse": 1,
      "text": "你能用魚鉤釣上鱷魚嗎？能用繩子壓下他的舌頭嗎？"
    },
    {
      "verse": 2,
      "text": "你能用繩索穿他的鼻子嗎？能用鉤穿他的腮骨嗎？"
    },
    {
      "verse": 3,
      "text": "他豈向你連連懇求，說柔和的話嗎？"
    },
    {
      "verse": 4,
      "text": "豈肯與你立約，使你拿他永遠作奴僕嗎？"
    },
    {
      "verse": 5,
      "text": "你豈可拿他當雀鳥玩耍嗎？豈可為你的幼女將他拴住嗎？"
    },
    {
      "verse": 6,
      "text": "搭夥的漁夫豈可拿他當貨物嗎？能把他分給商人嗎？"
    },
    {
      "verse": 7,
      "text": "你能用倒鉤槍扎滿他的皮，能用魚叉叉滿他的頭嗎？"
    },
    {
      "verse": 8,
      "text": "你按手在他身上，想與他爭戰，就不再這樣行吧！"
    },
    {
      "verse": 9,
      "text": "人指望捉拿他是徒然的；一見他，豈不喪膽嗎？"
    },
    {
      "verse": 10,
      "text": "沒有那麼兇猛的人敢惹他。這樣，誰能在我面前站立得住呢？"
    },
    {
      "verse": 11,
      "text": "誰先給我什麼，使我償還呢？天下萬物都是我的。"
    },
    {
      "verse": 12,
      "text": "論到鱷魚的肢體和其大力，並美好的骨骼，我不能緘默不言。"
    },
    {
      "verse": 13,
      "text": "誰能剝他的外衣？誰能進他上下牙骨之間呢？"
    },
    {
      "verse": 14,
      "text": "誰能開他的腮頰？他牙齒四圍是可畏的。"
    },
    {
      "verse": 15,
      "text": "他以堅固的鱗甲為可誇，緊緊合閉，封得嚴密。"
    },
    {
      "verse": 16,
      "text": "這鱗甲一一相連，甚至氣不得透入其間，"
    },
    {
      "verse": 17,
      "text": "都是互相聯絡、膠結，不能分離。"
    },
    {
      "verse": 18,
      "text": "他打噴嚏就發出光來；他眼睛好像早晨的光線（原文是眼皮）。"
    },
    {
      "verse": 19,
      "text": "從他口中發出燒著的火把，與飛迸的火星；"
    },
    {
      "verse": 20,
      "text": "從他鼻孔冒出煙來，如燒開的鍋和點著的蘆葦。"
    },
    {
      "verse": 21,
      "text": "他的氣點著煤炭，有火焰從他口中發出。"
    },
    {
      "verse": 22,
      "text": "他頸項中存著勁力；在他面前的都恐嚇蹦跳。"
    },
    {
      "verse": 23,
      "text": "他的肉塊互相聯絡，緊貼其身，不能搖動。"
    },
    {
      "verse": 24,
      "text": "他的心結實如石頭，如下磨石那樣結實。"
    },
    {
      "verse": 25,
      "text": "他一起來，勇士都驚恐，心裡慌亂，便都昏迷。"
    },
    {
      "verse": 26,
      "text": "人若用刀，用槍，用標槍，用尖槍扎他，都是無用。"
    },
    {
      "verse": 27,
      "text": "他以鐵為乾草，以銅為爛木。"
    },
    {
      "verse": 28,
      "text": "箭不能恐嚇他使他逃避；彈石在他看為碎稭。"
    },
    {
      "verse": 29,
      "text": "棍棒算為禾稭；他嗤笑短槍颼的響聲。"
    },
    {
      "verse": 30,
      "text": "他肚腹下如尖瓦片；他如釘耙經過淤泥。"
    },
    {
      "verse": 31,
      "text": "他使深淵開滾如鍋，使洋海如鍋中的膏油。"
    },
    {
      "verse": 32,
      "text": "他行的路隨後發光，令人想深淵如同白髮。"
    },
    {
      "verse": 33,
      "text": "在地上沒有像他造的那樣，無所懼怕。"
    },
    {
      "verse": 34,
      "text": "凡高大的，他無不藐視；他在驕傲的水族上作王。"
    }
  ]
}
