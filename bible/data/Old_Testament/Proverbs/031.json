{
  "translation": "Chinese_Union_Version_Traditional",
  "testament": "Old_Testament",
  "testament_zh": "舊約",
  "book": "Proverbs",
  "book_zh": "箴言",
  "chapter": 31,
  "verse_count": 31,
  "verses": [
    {
      "verse": 1,
      "text": "利慕伊勒王的言語，是他母親教訓他的真言。"
    },
    {
      "verse": 2,
      "text": "我的兒啊，我腹中生的兒啊，我許願得的兒啊！我當怎樣教訓你呢？"
    },
    {
      "verse": 3,
      "text": "不要將你的精力給婦女；也不要有敗壞君王的行為。"
    },
    {
      "verse": 4,
      "text": "利慕伊勒啊，君王喝酒，君王喝酒不相宜；王子說濃酒在那裡也不相宜；"
    },
    {
      "verse": 5,
      "text": "恐怕喝了就忘記律例，顛倒一切困苦人的是非。"
    },
    {
      "verse": 6,
      "text": "可以把濃酒給將亡的人喝，把清酒給苦心的人喝，"
    },
    {
      "verse": 7,
      "text": "讓他喝了，就忘記他的貧窮，不再記念他的苦楚。"
    },
    {
      "verse": 8,
      "text": "你當為啞巴（或譯：不能自辯的）開口，為一切孤獨的伸冤。"
    },
    {
      "verse": 9,
      "text": "你當開口按公義判斷，為困苦和窮乏的辨屈。"
    },
    {
      "verse": 10,
      "text": "才德的婦人誰能得著呢？他的價值遠勝過珍珠。"
    },
    {
      "verse": 11,
      "text": "他丈夫心裡倚靠他，必不缺少利益；"
    },
    {
      "verse": 12,
      "text": "他一生使丈夫有益無損。"
    },
    {
      "verse": 13,
      "text": "他尋找羊羢和麻，甘心用手做工。"
    },
    {
      "verse": 14,
      "text": "他好像商船從遠方運糧來，"
    },
    {
      "verse": 15,
      "text": "未到黎明他就起來，把食物分給家中的人，將當做的工分派婢女。"
    },
    {
      "verse": 16,
      "text": "他想得田地就買來；用手所得之利栽種葡萄園。"
    },
    {
      "verse": 17,
      "text": "他以能力束腰，使膀臂有力。"
    },
    {
      "verse": 18,
      "text": "他覺得所經營的有利；他的燈終夜不滅。"
    },
    {
      "verse": 19,
      "text": "他手拿撚線竿，手把紡線車。"
    },
    {
      "verse": 20,
      "text": "他張手賙濟困苦人，伸手幫補窮乏人。"
    },
    {
      "verse": 21,
      "text": "他不因下雪為家裡的人擔心，因為全家都穿著朱紅衣服。"
    },
    {
      "verse": 22,
      "text": "他為自己製作繡花毯子；他的衣服是細麻和紫色布做的。"
    },
    {
      "verse": 23,
      "text": "他丈夫在城門口與本地的長老同坐，為眾人所認識。"
    },
    {
      "verse": 24,
      "text": "他做細麻布衣裳出賣，又將腰帶賣與商家。"
    },
    {
      "verse": 25,
      "text": "能力和威儀是他的衣服；他想到日後的景況就喜笑。"
    },
    {
      "verse": 26,
      "text": "他開口就發智慧；他舌上有仁慈的法則。"
    },
    {
      "verse": 27,
      "text": "他觀察家務，並不吃閒飯。"
    },
    {
      "verse": 28,
      "text": "他的兒女起來稱他有福；他的丈夫也稱讚他，"
    },
    {
      "verse": 29,
      "text": "說：才德的女子很多，惟獨你超過一切。"
    },
    {
      "verse": 30,
      "text": "艷麗是虛假的，美容是虛浮的；惟敬畏耶和華的婦女必得稱讚。"
    },
    {
      "verse": 31,
      "text": "願他享受操作所得的；願他的工作在城門口榮耀他。"
    }
  ]
}
