{
  "translation": "Chinese_Union_Version_Traditional",
  "testament": "Old_Testament",
  "testament_zh": "舊約",
  "book": "Job",
  "book_zh": "約伯記",
  "chapter": 39,
  "verse_count": 30,
  "verses": [
    {
      "verse": 1,
      "text": "山巖間的野山羊幾時生產，你知道嗎？母鹿下犢之期，你能察定嗎？"
    },
    {
      "verse": 2,
      "text": "他們懷胎的月數，你能數算嗎？他們幾時生產，你能曉得嗎？"
    },
    {
      "verse": 3,
      "text": "他們屈身，將子生下，就除掉疼痛。"
    },
    {
      "verse": 4,
      "text": "這子漸漸肥壯，在荒野長大，去而不回。"
    },
    {
      "verse": 5,
      "text": "誰放野驢出去自由？誰解開快驢的繩索？"
    },
    {
      "verse": 6,
      "text": "我使曠野作他的住處，使鹹地當他的居所。"
    },
    {
      "verse": 7,
      "text": "他嗤笑城內的喧嚷，不聽趕牲口的喝聲。"
    },
    {
      "verse": 8,
      "text": "遍山是他的草場；他尋找各樣青綠之物。"
    },
    {
      "verse": 9,
      "text": "野牛豈肯服事你？豈肯住在你的槽旁？"
    },
    {
      "verse": 10,
      "text": "你豈能用套繩將野牛籠在犁溝之間？他豈肯隨你耙山谷之地？"
    },
    {
      "verse": 11,
      "text": "豈可因他的力大就倚靠他？豈可把你的工交給他做嗎？"
    },
    {
      "verse": 12,
      "text": "豈可信靠他把你的糧食運到家，又收聚你禾場上的穀嗎？"
    },
    {
      "verse": 13,
      "text": "鴕鳥的翅膀歡然搧展，豈是顯慈愛的翎毛和羽毛嗎？"
    },
    {
      "verse": 14,
      "text": "因他把蛋留在地上，在塵土中使得溫暖；"
    },
    {
      "verse": 15,
      "text": "卻想不到被腳踹碎，或被野獸踐踏。"
    },
    {
      "verse": 16,
      "text": "他忍心待雛，似乎不是自己的；雖然徒受勞苦，也不為雛懼怕；"
    },
    {
      "verse": 17,
      "text": "因為神使他沒有智慧，也未將悟性賜給他。"
    },
    {
      "verse": 18,
      "text": "他幾時挺身展開翅膀，就嗤笑馬和騎馬的人。"
    },
    {
      "verse": 19,
      "text": "馬的大力是你所賜的嗎？他頸項上挓挱的騌是你給他披上的嗎？"
    },
    {
      "verse": 20,
      "text": "是你叫他跳躍像蝗蟲嗎？他噴氣之威使人驚惶。"
    },
    {
      "verse": 21,
      "text": "他在谷中刨地，自喜其力；他出去迎接佩帶兵器的人。"
    },
    {
      "verse": 22,
      "text": "他嗤笑可怕的事並不驚惶，也不因刀劍退回。"
    },
    {
      "verse": 23,
      "text": "箭袋和發亮的槍，並短槍在他身上錚錚有聲。"
    },
    {
      "verse": 24,
      "text": "他發猛烈的怒氣將地吞下；一聽角聲就不耐站立。"
    },
    {
      "verse": 25,
      "text": "角每發聲，他說呵哈；他從遠處聞著戰氣，又聽見軍長大發雷聲和兵丁吶喊。"
    },
    {
      "verse": 26,
      "text": "鷹雀飛翔，展開翅膀一直向南，豈是藉你的智慧嗎？"
    },
    {
      "verse": 27,
      "text": "大鷹上騰在高處搭窩，豈是聽你的吩咐嗎？"
    },
    {
      "verse": 28,
      "text": "他住在山巖，以山峯和堅固之所為家，"
    },
    {
      "verse": 29,
      "text": "從那裡窺看食物，眼睛遠遠觀望。"
    },
    {
      "verse": 30,
      "text": "他的雛也咂血；被殺的人在哪裡，他也在那裡。"
    }
  ]
}
