{
  "translation": "Chinese_Union_Version_Traditional",
  "testament": "Old_Testament",
  "testament_zh": "舊約",
  "book": "Esther",
  "book_zh": "以斯帖記",
  "chapter": 10,
  "verse_count": 3,
  "verses": [
    {
      "verse": 1,
      "text": "亞哈隨魯王使旱地和海島的人民都進貢。"
    },
    {
      "verse": 2,
      "text": "他以權柄能力所行的，並他擡舉末底改使他高升的事，豈不都寫在瑪代和波斯王的歷史上嗎？"
    },
    {
      "verse": 3,
      "text": "猶大人末底改作亞哈隨魯王的宰相，在猶大人中為大，得他眾弟兄的喜悅，為本族的人求好處，向他們說和平的話。"
    }
  ]
}
