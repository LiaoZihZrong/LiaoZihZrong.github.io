{
  "translation": "Chinese_Union_Version_Traditional",
  "testament": "Old_Testament",
  "testament_zh": "舊約",
  "book": "Psalms",
  "book_zh": "詩篇",
  "chapter": 120,
  "verse_count": 7,
  "verses": [
    {
      "verse": 1,
      "text": "（上行（或作登階，下同）之詩。）我在急難中求告耶和華，他就應允我。"
    },
    {
      "verse": 2,
      "text": "耶和華啊，求你救我脫離說謊的嘴唇和詭詐的舌頭！"
    },
    {
      "verse": 3,
      "text": "詭詐的舌頭啊，要給你什麼呢？要拿什麼加給你呢？"
    },
    {
      "verse": 4,
      "text": "就是勇士的利箭和羅騰木（小樹名，松類）的炭火。"
    },
    {
      "verse": 5,
      "text": "我寄居在米設，住在基達帳棚之中，有禍了！"
    },
    {
      "verse": 6,
      "text": "我與那恨惡和睦的人許久同住。"
    },
    {
      "verse": 7,
      "text": "我願和睦，但我發言，他們就要爭戰。"
    }
  ]
}
